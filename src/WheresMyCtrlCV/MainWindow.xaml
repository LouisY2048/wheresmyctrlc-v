<Window x:Class="WheresMyCtrlCV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Where’s my Ctrl+C / V" Width="790" Height="830" MinWidth="670" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#F3F7F7" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,25,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,19">
                <StackPanel>
                    <TextBlock Text="WHERE’S MY CTRL+C / V" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="粘贴不了，就帮你打出来。" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,7"/>
                    <TextBlock Text="把命令放在这里，切回控制台，让键盘替你输入。" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E2EFEB" CornerRadius="12" Padding="10,5">
                    <TextBlock Text="本地运行" FontSize="11" Foreground="{StaticResource Accent}"/>
                </Border>
            </Grid>
            <Border Grid.Row="1" CornerRadius="10" Background="White" BorderBrush="#D9E4E2" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PasteButton" Content="粘贴" Padding="12,5" Click="Paste_Click" AutomationProperties.Name="从剪贴板粘贴"/>
                            <Button x:Name="ClearButton" Content="清空" Padding="12,5" Margin="7,0,0,0" Click="Clear_Click"/>
                        </StackPanel>
                        <TextBlock Text="待输入的命令" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="CommandBox" Grid.Row="1" Height="170" AcceptsReturn="True" AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas" FontSize="15" Background="#F8FAFA" Foreground="#183B36"
                             BorderBrush="#D9E4E2" Padding="12" TextChanged="Command_TextChanged"
                             SpellCheck.IsEnabled="False" AutomationProperties.Name="待输入的命令"/>
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="EstimateLabel" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock x:Name="CountLabel" Text="0 个字符" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </DockPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,17,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="130"/><ColumnDefinition Width="16"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="输入方式" Margin="0,0,0,7"/>
                        <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="Setting_Changed" AutomationProperties.Name="输入方式">
                            <ComboBoxItem Content="实体按键 · 远程控制台 / iBMC"/>
                            <ComboBoxItem Content="Unicode · 普通 Windows 输入框"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="每个字符间隔" Margin="0,0,0,7"/>
                        <ComboBox x:Name="SpeedBox" SelectedIndex="2" SelectionChanged="Setting_Changed" AutomationProperties.Name="每个字符间隔">
                            <ComboBoxItem Content="20 ms · 快" Tag="20"/>
                            <ComboBoxItem Content="50 ms" Tag="50"/>
                            <ComboBoxItem Content="80 ms · 稳妥" Tag="80"/>
                            <ComboBoxItem Content="150 ms · 慢" Tag="150"/>
                            <ComboBoxItem Content="300 ms · 很慢" Tag="300"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="切换窗口时间" Margin="0,0,0,7"/>
                        <ComboBox x:Name="CountdownBox" SelectedIndex="1" AutomationProperties.Name="切换窗口时间">
                            <ComboBoxItem Content="3 秒" Tag="3"/>
                            <ComboBoxItem Content="5 秒" Tag="5"/>
                            <ComboBoxItem Content="8 秒" Tag="8"/>
                            <ComboBoxItem Content="10 秒" Tag="10"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ModeHint" Margin="0,9,0,9" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="适用于英文命令。请使用英文输入法，关闭 Caps Lock，并将远端键盘设为 US。"/>
                <CheckBox x:Name="LineBreaksBox" Content="允许命令中的换行发送 Enter（可能逐行执行）" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="AppendEnterBox" Content="全部输入后，再按一次 Enter" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <TextBlock x:Name="EnterHint" Text="默认只输入，不执行。你可以在控制台检查后手动按回车。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="3" Margin="0,18,0,0" Background="#E7F0EE" CornerRadius="8" Padding="14,11">
                <StackPanel>
                    <TextBlock Text="1  粘贴命令     →     2  开始倒计时     →     3  点击目标控制台的输入区域" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="倒计时结束后锁定当前窗口。输入中按 F8 停止；切换窗口也会停止。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="StopButton" Content="停止 · F8" Visibility="Collapsed" Margin="0,0,10,0" Click="Stop_Click"/>
                        <Button x:Name="StartButton" Content="开始倒计时 →" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Padding="22,12" FontWeight="SemiBold" Click="Start_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="StatusLabel" Text="准备就绪" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="ProgressLabel" Text="命令仅保留在本次窗口中，不保存历史。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="SendProgress" Grid.Row="1" Height="3" Margin="0,13,0,0" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#DBE7E4" BorderThickness="0"/>
                <TextBlock x:Name="ErrorLabel" Grid.Row="2" Visibility="Collapsed" Foreground="#AA401D" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </Grid>
            <TextBlock x:Name="HotkeyHint" Grid.Row="5" Text="Ctrl + Alt + V 唤起窗口   ·   Esc 取消当前输入" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,19,0,0"/>
        </Grid>
    </ScrollViewer>
</Window>
